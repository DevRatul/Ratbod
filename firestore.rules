rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
       allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    match /users/{userId} {
      // Allow read/write to the main user profile
      allow read, write: if isValidId(userId) && isOwner(userId);
      
      // Allow read/write to all appData documents stored for this user (history, habits, goals, etc.)
      match /appData/{docId} {
        allow read, write: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }
    }
  }
}
