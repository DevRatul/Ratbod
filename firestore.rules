rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidHistoryEntry(data) {
      return data.keys().hasAll(['id', 'date', 'metrics', 'createdAt']) && (data.createdAt is timestamp || data.createdAt is number);
    }

    function isValidHabitItem(data) {
      return data.keys().hasAll(['id', 'text', 'createdAt']) && (data.createdAt is timestamp || data.createdAt is number);
    }

    function isValidHabitLog(data) {
      return data.keys().hasAll(['completedIds', 'updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidWaterTracker(data) {
      return data.keys().hasAll(['updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidGoalData(data) {
      return data.keys().hasAll(['updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidGroceryItem(data) {
      return data.keys().hasAll(['id', 'name', 'quantity', 'price', 'checked', 'updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidGenericSync(data) {
      return data.keys().hasAll(['value', 'updatedAt']) && (data.updatedAt is timestamp || data.updatedAt is number);
    }

    match /users/{userId} {
      allow read: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      
      match /history/{entryId} {
        allow read: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isValidHistoryEntry(incoming());
        allow update: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isValidHistoryEntry(incoming());
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      }

      match /habits/{habitId} {
        allow read: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(habitId) && isOwner(userId) && isValidHabitItem(incoming());
        allow update: if isValidId(userId) && isValidId(habitId) && isOwner(userId) && isValidHabitItem(incoming());
        allow delete: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
      }

      match /habitLogs/{dateKey} {
        allow read: if isValidId(userId) && isValidId(dateKey) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && isValidHabitLog(incoming());
        allow update: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && isValidHabitLog(incoming());
        allow delete: if isValidId(userId) && isValidId(dateKey) && isOwner(userId);
      }

      match /waterTracker/{dateKey} {
        allow read: if isValidId(userId) && isValidId(dateKey) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && isValidWaterTracker(incoming());
        allow update: if isValidId(userId) && isValidId(dateKey) && isOwner(userId) && isValidWaterTracker(incoming());
        allow delete: if isValidId(userId) && isValidId(dateKey) && isOwner(userId);
      }

      match /goals/current {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && isValidGoalData(incoming());
        allow update: if isValidId(userId) && isOwner(userId) && isValidGoalData(incoming());
        allow delete: if isValidId(userId) && isOwner(userId);
      }

      match /groceries/{itemId} {
        allow read: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(itemId) && isOwner(userId) && isValidGroceryItem(incoming());
        allow update: if isValidId(userId) && isValidId(itemId) && isOwner(userId) && isValidGroceryItem(incoming());
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }
    }
  }
}
